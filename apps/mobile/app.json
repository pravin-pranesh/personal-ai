{
  "expo": {
    "name": "Personal AI",
    "slug": "personal-ai-task-store",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "personal-ai",
    "userInterfaceStyle": "light",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#2563EB"
        }
      ],
      "expo-secure-store"
    ],
    "android": {
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "READ_EXTERNAL_STORAGE"
      ]
    }
  }
}
